// ~/.config/fastfetch/config.jsonc
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "~/.cache/palette/current-preview.png",
    "width": 30,
    "height": 15,
    "preserveAspectRatio": true,
    "padding": {
      "top": 1,
      "left": 2,
      "right": 2
    }
  },
  "display": {
    "separator": " -> ",
    "constants": [
      "──────────────────────────────────────────────────",
      "│\u001b[50C│\u001b[50D"
    ],
    "color": {
        "keys": "magenta", // Sets the default color for all keys
        "output": "white"   // Sets the default color for the values
    }
  },
  "modules": [
    "break",
    "break",
    {
      "type": "title",
      "format": "{#magenta}╭{$1}╮\u001b[76D",
      "color": {
        "user": "cyan",
        "at": "white",
        "host": "magenta"
      }
    },
    {
      "type": "os",
      "key": "{$2}{#green}{icon} ",
    },
    {
      "type": "de",
      "key": "{$2}{#green} ",
    },
    {
      "type": "wm",
      "key": "{$2}{#green} ",
    },
    {
      "type": "uptime",
      "key": "{$2}{#blue}󰅐 ",
    },
    {
      "type": "command",
      "key": "{$2}{#blue} ",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
    },
    {
      "type": "media",
      "key": "{$2}{#blue}󰝚 ",
    },
    {
      "type": "host",
      "key": "{$2}{#cyan} ",
    },
    {
      "type": "cpu",
      "key": "{$2}{#cyan} ",
      "format": "{1}"
    },
    {
      "type": "gpu",
      "key": "{$2}{#cyan} ",
      "format": "{1} {2}"
    },
    {
      "type": "display",
      "key": "{$2}{#cyan}󰇄 ",
      "format": "{6}: {1}x{2}@{3}"
    },
    {
      "type": "custom",
      "format": "{#magenta}╰{$1}╯"
    },
    {
      "type": "colors",
      "paddingLeft": 18,
      "symbol": "circle"
    }
  ]
}
