#!/bin/bash

# Ensure consistent command output language
export LC_ALL=C

# Use default aliases supported by modern PulseAudio and PipeWire
SINK="@DEFAULT_SINK@"
SOURCE="@DEFAULT_SOURCE@"

# Asymmetry Config
RATIO=1.16  # (Right = Left * RATIO)

# Icon directory fallback (adjust if needed)
iDIR="${iDIR:-$HOME/.config/mako/icons}"

# Get left channel volume (as integer)
get_left_volume() {
    # Extract the percentage of the first channel safely
    pactl get-sink-volume "$SINK" 2>/dev/null | awk -F'/' '/\// {print $2; exit}' | grep -o '[0-9]\+' | head -n1
}

# Set both channels, integer % only
set_volume() {
    local left=$1
    local right
    right=$(awk "BEGIN {printf \"%d\", $left * $RATIO}")
    pactl set-sink-volume "$SINK" "${left}%" "${right}%" 2>/dev/null
}

# Increase volume (keeping ratio)
inc_volume() {
    local left
    left=$(get_left_volume)
    left=${left:-0}
    (( left == 0 )) && left=1  # safety if unset
    local new_left=$((left + 2))
    (( new_left > 100 )) && new_left=100
    set_volume "$new_left"
    notify_user
}

# Decrease volume (keeping ratio)
dec_volume() {
    local left
    left=$(get_left_volume)
    left=${left:-0}
    local new_left=$((left - 2))
    (( new_left < 0 )) && new_left=0
    set_volume "$new_left"
    notify_user
}

# Toggle mute
toggle_mute() {
    pactl set-sink-mute "$SINK" toggle 2>/dev/null
}

# --- Icons ---
get_icon() {
    local current
    current=$(get_left_volume)
    current=${current:-0}
    if [[ "$current" -eq 0 ]]; then
        echo "$iDIR/volume-mute.png"
    elif [[ "$current" -ge 0 && "$current" -le 30 ]]; then
        echo "$iDIR/volume-low.png"
    elif [[ "$current" -ge 30 && "$current" -le 60 ]]; then
        echo "$iDIR/volume-mid.png"
    else
        echo "$iDIR/volume-high.png"
    fi
}

# --- Notifications ---
notify_user() {
    # notify-send -h string:x-canonical-private-synchronous:sys-notify -u low -i "$(get_icon)" "Volume : $(get_left_volume) %"
    true
}

# --- Mic controls ---
toggle_mic() {
    pactl set-source-mute "$SOURCE" toggle 2>/dev/null
}

get_mic_icon() {
    echo "$iDIR/microphone.png"
}

get_mic_volume() {
    pactl get-source-volume "$SOURCE" 2>/dev/null | awk -F'/' '/\// {print $2; exit}' | grep -o '[0-9]\+' | head -n1
}

notify_mic_user() {
    # notify-send -h string:x-canonical-private-synchronous:sys-notify -u low -i "$(get_mic_icon)" "Mic-Level : $(get_mic_volume) %"
    true
}

inc_mic_volume() {
    pactl set-source-volume "$SOURCE" +5% 2>/dev/null && notify_mic_user
}

dec_mic_volume() {
    pactl set-source-volume "$SOURCE" -5% 2>/dev/null && notify_mic_user
}

# --- Dispatcher ---
case "$1" in
    --set) set_volume "$2" ;;
    --get) get_left_volume ;;
    --inc) inc_volume ;;
    --dec) dec_volume ;;
    --toggle) toggle_mute ;;
    --toggle-mic) toggle_mic ;;
    --get-icon) get_icon ;;
    --get-mic-icon) get_mic_icon ;;
    --mic-inc) inc_mic_volume ;;
    --mic-dec) dec_mic_volume ;;
    *) get_left_volume ;;
esac
